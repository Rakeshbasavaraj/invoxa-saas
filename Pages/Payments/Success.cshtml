@page
@model Invoxa.Web.Pages.Payments.SuccessModel
@{
    ViewData["Title"] = "Payment Success";
}

<div class="card" style="max-width:760px;margin:0 auto;">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="notice" style="margin-bottom:12px;">@Model.Message</div>
    }

    <div style="font-size:30px;font-weight:900;color:#166534;">Payment Successful</div>
    <div style="color:#6b7280;margin-top:6px;">Thank you. Your payment has been confirmed.</div>

    @if (Model.Invoice != null)
    {
        <div style="height:18px"></div>
        <div class="card" style="background:#f8fafc;border:1px solid #e5e7eb;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div>
                    <div style="font-size:13px;color:#6b7280;">Invoice</div>
                    <div style="font-size:22px;font-weight:800;">@Model.Invoice.InvoiceNumber</div>
                </div>
                <div>
                    <div style="font-size:13px;color:#6b7280;">Amount Paid</div>
                    <div style="font-size:22px;font-weight:800;">@InvoiceMoney.FormatAmount(InvoiceMoney.GetGrandTotal(Model.Invoice, Model.Company), Model.Company)</div>
                </div>
                <div>
                    <div style="font-size:13px;color:#6b7280;">Status</div>
                    <div style="font-weight:800;color:#166534;">@Model.Invoice.Status</div>
                </div>
                <div>
                    <div style="font-size:13px;color:#6b7280;">Paid On</div>
                    <div style="font-weight:800;">@(Model.Invoice.PaidAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                </div>
            </div>
        </div>

        <div style="height:16px"></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <a class="btn primary" href="/i/@Model.Invoice.PublicToken">View Invoice</a>
            <form method="post" asp-page-handler="Download" asp-route-token="@Model.Invoice.PublicToken">
                <button class="btn" type="submit"><i class="bi bi-download"></i> Download PDF</button>
            </form>
        </div>
    }
</div>
