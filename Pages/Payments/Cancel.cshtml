@page
@model Invoxa.Web.Pages.Payments.CancelModel
@{
    ViewData["Title"] = "Payment Cancelled";
}
<div class="card" style="max-width:760px;margin:0 auto;">
    <div style="font-size:30px;font-weight:900;color:#b45309;">Payment Cancelled</div>
    <div style="color:#6b7280;margin-top:6px;">No payment was taken. You can return to the invoice and try again.</div>
    <div style="height:16px"></div>
    @if (!string.IsNullOrWhiteSpace(Model.Token))
    {
        <a class="btn primary" href="/i/@Model.Token">Back to Invoice</a>
    }
</div>
