@page
@model Invoxa.Web.Pages.Account.ResetPasswordModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="brand-badge"><i class="bi bi-arrow-repeat"></i></div>
        <div class="brand-name">Invoxa</div>
    </div>

    <div class="auth-body">
        <h1 class="auth-title">Reset Password</h1>
        <p class="auth-subtitle">Create a new password for your account.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="notice-box">@Model.Message</div>
        }

        @if (!ViewContext.ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="validation-box"></div>
        }

        <form method="post">
            <input type="hidden" asp-for="Input.Token" />

            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" type="password" placeholder="Enter new password" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" type="password" placeholder="Confirm new password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-main">Reset Password</button>
        </form>

        <div class="footer-link">
            Back to <a asp-page="/Account/Login">Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
