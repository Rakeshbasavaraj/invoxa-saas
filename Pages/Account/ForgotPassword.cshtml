@page
@model Invoxa.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="brand-badge"><i class="bi bi-shield-lock"></i></div>
        <div class="brand-name">Invoxa</div>
    </div>

    <div class="auth-body">
        <h1 class="auth-title">Forgot Password</h1>
        <p class="auth-subtitle">Enter your email and we will send a password reset link.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="notice-box">@Model.Message</div>
        }

        @if (!ViewContext.ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="validation-box"></div>
        }

        <form method="post">
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" type="email" placeholder="Enter your account email" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <button type="submit" class="btn-main">Send Reset Link</button>
        </form>

        <div class="footer-link">
            Back to <a asp-page="/Account/Login">Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
