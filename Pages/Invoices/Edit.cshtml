@page "{id:guid}"
@model Invoxa.Web.Pages.Invoices.EditModel
@{ ViewData["Title"] = "Edit Invoice"; }
<form method="post" class="form">
  <div class="row">
    <div class="input"><label>Invoice Number</label><input asp-for="InvoiceNumber" readonly /></div>
    <div class="input"><label>Status</label><select asp-for="Status" asp-items="Model.StatusOptions"></select></div>
  </div>
  <div class="row">
    <div class="input"><label>Issue Date</label><input asp-for="IssueDate" type="date" required /></div>
    <div class="input"><label>Due Date</label><input asp-for="DueDate" type="date" required /></div>
  </div>
  <div class="input" style="margin-bottom:12px"><label>Notes</label><textarea asp-for="Notes" rows="3"></textarea></div>

  <div class="card" style="margin-bottom:12px">
    <div style="font-weight:700;margin-bottom:8px">Recurring (optional)</div>
    <div class="row">
      <label class="form-check" style="display:flex;gap:8px;align-items:center">
        <input class="form-check-input" type="checkbox" asp-for="IsRecurringTemplate" />
        <span>Use this invoice as a recurring template</span>
      </label>
      <label class="form-check" style="display:flex;gap:8px;align-items:center">
        <input class="form-check-input" type="checkbox" asp-for="RecurrenceEnabled" />
        <span>Enable automation</span>
      </label>
    </div>
    <div class="row" style="margin-top:10px">
      <div class="input"><label>Interval (days)</label><input asp-for="RecurrenceIntervalDays" type="number" min="1" /></div>
      <div class="input" style="color:#64748b;display:flex;align-items:end">Example: 30 = monthly, 7 = weekly</div>
    </div>
  </div>

  <div class="card" style="padding:0">

  <div class="card" style="margin-bottom:12px">
    <div style="font-weight:700;margin-bottom:8px">Ship To (optional)</div>

    <label class="form-check" style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
      <input class="form-check-input" type="checkbox" asp-for="ShipToSameAsBillTo" id="shipSame" />
      <span>Same as Bill To (Client)</span>
    </label>

    <div id="shipFields">
      <div class="row">
        <div class="input"><label>Ship To Name</label><input asp-for="ShipToName" /></div>
        <div class="input"><label>Ship To Address Line 1</label><input asp-for="ShipToAddressLine1" /></div>
      </div>
      <div class="row">
        <div class="input"><label>Ship To Address Line 2</label><input asp-for="ShipToAddressLine2" /></div>
        <div class="input"><label>Ship To City</label><input asp-for="ShipToCity" /></div>
      </div>
      <div class="row">
        <div class="input"><label>Ship To Country</label><input asp-for="ShipToCountry" /></div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const cb = document.getElementById('shipSame');
      const fields = document.getElementById('shipFields');
      if(!cb || !fields) return;
      function toggle(){ fields.style.display = cb.checked ? 'none' : ''; }
      cb.addEventListener('change', toggle);
      toggle();
    })();
  </script>


    <table class="table">
      <thead><tr><th>Description</th><th style="width:110px">Qty</th><th style="width:140px">Unit Price</th><th style="width:48px"></th></tr></thead>
      <tbody id="itemsBody">
      @for (var i = 0; i < Model.Items.Count; i++)
      {
        <tr>
          <td><input name="Items[@i].Description" value="@Model.Items[i].Description" /></td>
          <td><input name="Items[@i].Quantity" value="@Model.Items[i].Quantity" type="number" min="1" /></td>
          <td><input name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice" type="number" step="0.01" /></td>
          <td style="text-align:right"><button class="btn icon-btn reset-btn" type="button" onclick="removeRow(this)" title="Remove"><i class="bi bi-x"></i></button></td>
        </tr>
      }
      </tbody>
    </table>
  </div>

  <div style="height:10px"></div>
  <button class="btn" type="button" onclick="addRow()"><i class="bi bi-plus-lg"></i> Add Item</button>

  <div style="height:12px"></div>
  <div class="stack">
    <button class="btn primary" type="submit">Save Changes</button>
    <a class="btn" asp-page="/Invoices/Details" asp-route-id="@Model.Id">Back</a>
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.Message))
  {
    <div style="height:10px"></div>
    <div class="notice">@Model.Message</div>
  }
</form>

<template id="itemRowTpl">
  <tr>
    <td><input name="__NAME__.Description" value="" /></td>
    <td><input name="__NAME__.Quantity" value="1" type="number" min="1" /></td>
    <td><input name="__NAME__.UnitPrice" value="0" type="number" step="0.01" /></td>
    <td style="text-align:right"><button class="btn icon-btn reset-btn" type="button" onclick="removeRow(this)" title="Remove"><i class="bi bi-x"></i></button></td>
  </tr>
</template>

<script>
  function reindex() {
    const rows = document.querySelectorAll('#itemsBody tr');
    rows.forEach((row, idx) => {
      row.querySelectorAll('input').forEach(inp => {
        const parts = inp.name.split('.');
        inp.name = `Items[${idx}].${parts[1]}`;
      });
    });
  }

  function addRow() {
    const body = document.getElementById('itemsBody');
    const tpl = document.getElementById('itemRowTpl');
    const frag = tpl.content.cloneNode(true);
    body.appendChild(frag);
    reindex();
  }

  function removeRow(btn) {
    const tr = btn.closest('tr');
    tr.remove();
    if (document.querySelectorAll('#itemsBody tr').length === 0) addRow();
    reindex();
  }

  reindex();
</script>
